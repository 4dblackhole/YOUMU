<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <YOUMURoot>$(MSBuildThisFileDirectory)</YOUMURoot>
    <BaseOutputPath>$(YOUMURoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(YOUMURoot)build\obj\</BaseIntermediateOutputPath>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>

    <FmodRoot Condition="'$(FmodRoot)' == '' and '$(FMOD_ROOT)' != ''">$(FMOD_ROOT)</FmodRoot>
    <FmodRoot Condition="'$(FmodRoot)' == '' and Exists('C:\Program Files (x86)\FMOD SoundSystem\FMOD Studio API Windows\api\core\inc\fmod.hpp')">C:\Program Files (x86)\FMOD SoundSystem\FMOD Studio API Windows</FmodRoot>
    <FmodIncludeDir>$(FmodRoot)\api\core\inc</FmodIncludeDir>
    <FmodLibraryDir>$(FmodRoot)\api\core\lib\x64</FmodLibraryDir>

    <!-- NVIDIA Nsight Aftermath, only for a build made with /p:PhantomCoreAftermath=true. The SDK folder is
         outside the repository, as in the engine's own Directory.Build.props. -->
    <AftermathRoot Condition="'$(AftermathRoot)' == '' and '$(NSIGHT_AFTERMATH_SDK)' != ''">$(NSIGHT_AFTERMATH_SDK)</AftermathRoot>
  </PropertyGroup>

  <!-- Release links the C/C++ runtime statically (/MT) so the binaries run without the Visual C++
       redistributable. Every project must agree, or the linker reports LNK2038. Debug keeps /MDd.
       Tests/Presentation/Run*.ps1 pass the same flag to cl for Release. -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
